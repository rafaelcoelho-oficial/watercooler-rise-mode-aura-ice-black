  <String Id="Caption" Value="Instalador do Aura Ice Controller" />
  <String Id="Title" Value="Aura Ice Controller" />
  <String Id="InstallMessage" Value="Este assistente configura o visor Rise Mode Aura Ice Black para mostrar a temperatura da CPU. Se necessário, instalará o driver PawnIO, de terceiros, usado para ler os sensores. Requer Internet e autorização de administrador; talvez seja preciso reiniciar o computador." />

  <String Id="HelpHeader" Value="Ajuda" />
  <String Id="HelpText" Value="Instala o Aura Ice Controller e, se necessário, o driver PawnIO para leitura dos sensores de temperatura da CPU." />
