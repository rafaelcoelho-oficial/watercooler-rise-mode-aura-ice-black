<Application x:Class="AuraIce.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#091421" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0D1B2B" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0F2032" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#285782" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F7FF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CB1C7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6E849A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#45D9F3" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4B8BFF" />
        <SolidColorBrush x:Key="OnlineBrush" Color="#4BE8A6" />
        <SolidColorBrush x:Key="OfflineBrush" Color="#F0A06F" />
        <SolidColorBrush x:Key="UnknownBrush" Color="#718196" />

        <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1B2B" Offset="0" />
            <GradientStop Color="#07111D" Offset="0.55" />
            <GradientStop Color="#0A1725" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#12263A" Offset="0" />
            <GradientStop Color="#0C1928" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GaugeGradientBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#3777FF" Offset="0" />
            <GradientStop Color="#41E0F2" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadow" BlurRadius="26" ShadowDepth="7" Opacity="0.48" Color="#000000" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="#102235" />
            <Setter Property="BorderBrush" Value="#284A6D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#193552" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#3E83BA" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#234A6D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="13,11" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#0B1725" />
            <Setter Property="BorderBrush" Value="#315A80" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SettingsSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="31" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="#17486A" />
        </Style>

        <Geometry x:Key="CpuIconGeometry">M 6,1 L 6,4 M 12,1 L 12,4 M 6,14 L 6,17 M 12,14 L 12,17 M 1,6 L 4,6 M 1,12 L 4,12 M 14,6 L 17,6 M 14,12 L 17,12 M 5,4 L 13,4 L 13,14 L 5,14 Z</Geometry>
        <Geometry x:Key="FrequencyIconGeometry">M 1,10 L 5,10 L 8,3 L 12,15 L 15,8 L 18,8</Geometry>
        <Geometry x:Key="VoltageIconGeometry">M 11,1 L 4,10 L 9,10 L 7,17 L 15,7 L 10,7 Z</Geometry>
        <Geometry x:Key="PowerIconGeometry">M 2,15 L 2,11 M 7,15 L 7,7 M 12,15 L 12,3 M 17,15 L 17,1</Geometry>
        <Geometry x:Key="DisplayIconGeometry">M 2,3 L 16,3 L 16,12 L 2,12 Z M 9,12 L 9,16 M 5,16 L 13,16</Geometry>
    </Application.Resources>
</Application>
