<Window x:Class="AuraIce.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aura Ice Controller"
        Width="430"
        Height="570"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="#AFC2D2" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1C2B3C" />
                                <Setter Property="Foreground" Value="#F4FAFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#263B50" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="#EFF8FD" />
            <Setter Property="Background" Value="#0C1520" />
            <Setter Property="BorderBrush" Value="#2B4056" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="SettingsSaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#07141D" />
            <Setter Property="Background" Value="#64D5EF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#8AE5F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#48BBD5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="9" CornerRadius="27" Background="#0C131E" BorderBrush="#26374A" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Grid Margin="19,14,19,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderBar" Grid.Row="0" MouseLeftButtonDown="Window_Drag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Image Width="30" Height="30" Source="pack://application:,,,/assets/star.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                        <TextBlock Text="AURA ICE" Foreground="#E9F4FC" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="CPU MONITOR" Foreground="#8195A9" FontSize="8" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource ChromeButtonStyle}"
                            ToolTip="Configurações" Click="SettingsButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ChromeButtonStyle}" Content="−"
                            ToolTip="Minimizar para a bandeja" Click="MinimizeButton_Click" />
                    <Button Grid.Column="4" Style="{StaticResource ChromeButtonStyle}" Content="×"
                            ToolTip="Ocultar widget" Click="CloseButton_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,1,0,1">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="320" Height="320">
                            <Ellipse Width="304" Height="304" Fill="#101B29" Stroke="#172A3B" StrokeThickness="1" />
                            <Canvas x:Name="GaugeCanvas" Width="320" Height="320" IsHitTestVisible="False" />
                            <Ellipse Width="214" Height="214" Fill="#111D2B" Stroke="#1A3043" StrokeThickness="1" />
                            <Ellipse Width="196" Height="196" Stroke="#142638" StrokeThickness="1" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <TextBlock Text="TEMPERATURA DA CPU" Foreground="#91A8BC" FontSize="9"
                                           FontWeight="Bold" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0">
                                    <TextBlock x:Name="TemperatureText" Text="—" Foreground="#F2F8FD"
                                               FontSize="54" FontWeight="Light" VerticalAlignment="Center" />
                                    <TextBlock Text="°C" Foreground="#72D8EE" FontSize="18"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,16,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="GaugeStatusText" Text="Aguardando leitura"
                                           Foreground="#8299AD" FontSize="9" HorizontalAlignment="Center"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="DeviceStatusDot" Width="7" Height="7" Fill="#718196" VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceStatusText" Text="Display verificando" Foreground="#B7C9D8"
                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Ellipse x:Name="ServiceStatusDot" Width="7" Height="7" Fill="#718196"
                                 VerticalAlignment="Center" Margin="17,0,0,0" />
                        <TextBlock x:Name="ServiceStatusText" Text="Serviço verificando" Foreground="#B7C9D8"
                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="MessageText" Grid.Row="1" Text="Conectando ao serviço Aura Ice..."
                               Foreground="#8196A9" FontSize="9" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </Grid>
        </Border>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" HorizontalOffset="-213" VerticalOffset="7"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Width="258" Padding="16" CornerRadius="17" Background="#142131"
                    BorderBrush="#2B4056" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="CONFIGURAÇÕES" Foreground="#E9F4FC" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Intervalo de atualização" Foreground="#91A8BC" FontSize="10" Margin="0,13,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IntervalTextBox" Style="{StaticResource SettingsTextBoxStyle}" />
                        <TextBlock Grid.Column="1" Text="ms" Foreground="#91A8BC" FontSize="10"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SettingsSaveButtonStyle}"
                                Content="Salvar" Click="SaveButton_Click" />
                    </Grid>
                    <TextBlock x:Name="SettingsMessageText" Text="Entre 250 e 10000 ms."
                               Foreground="#8196A9" FontSize="9" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
